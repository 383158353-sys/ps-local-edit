{
  "manifestVersion": 5,
  "id": "com.local.lk888.psedit",
  "name": "局部改图",
  "version": "0.4.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editPanel",
      "label": {
        "default": "局部改图"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 800
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    },
    "clipboard": "read",
    "launchProcess": {
      "extensions": [
        ".png",
        ".jpg",
        ".webp"
      ]
    }
  }
}
